    "@testing-library/user-event": "^14.5.2",
    "@testing-library/vue": "^8.0.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^1.2.2",
    "@vitest/ui": "^1.2.2",
